                                                            }
                                                        ]
                                                    },
                                                    {
                                                        "data": {
                                                            "id": "d8azwrhmbmg0",
                                                            "created": 1741448323375,
                                                            "text": "トークン",
                                                            "layout": null,
                                                            "note": "モデルが処理する文字の単位（テキストを分割したもの）\n"
                                                        },
                                                        "children": []
                                                    },
                                                    {
                                                        "data": {
                                                            "id": "d8azz4ni12w0",
                                                            "created": 1741448508757,
                                                            "text": "埋め込みベクトル",
                                                            "note": "「意味的な近さ」を表す数値・ベクトル\n",
                                                            "layout": null
                                                        },
                                                        "children": []
                                                    },
                                                    {
                                                        "data": {
                                                            "id": "d8hjx8gbum80",
                                                            "created": 1742114142240,
                                                            "text": " 推論パラメータ",
                                                            "expandState": "expand"
                                                        },
                                                        "children": [
                                                            {
                                                                "data": {
                                                                    "id": "d8hjxdnoujk0",
                                                                    "created": 1742114153569,
                                                                    "text": "温度",
                                                                    "note": "低いほど保守的、高いほど創造的"
                                                                },
                                                                "children": []
                                                            },
                                                            {
                                                                "data": {
                                                                    "id": "d8hjyrgqpm00",
                                                                    "created": 1742114261988,
                                                                    "text": "トップP",
                                                                    "note": "確率分布のX%に含まれる単語を分析対象にする。\n低いほど、コンテキストに関連性が高い単語の中から選択する。\n高いほど、出力に使用する単語の範囲が増え、創造的になる"
                                                                },
                                                                "children": []
                                                            },
                                                            {
                                                                "data": {
                                                                    "id": "d8hk2z94oow0",
                                                                    "created": 1742114592399,
                                                                    "text": "トップK",
                                                                    "note": "出力する単語の可能性が高い上位X個を使う。\nトップPは確立分布、トップKは上位。"
                                                                },
                                                                "children": []
                                                            },
                                                            {
                                                                "data": {
                                                                    "id": "d8hk59mgji00",
                                                                    "created": 1742114771701,
                                                                    "text": "最大長",
                                                                    "note": "出力の最大長。過剰な出力にｙるリソースの枯渇や望ましくない動作を防ぐ"
                                                                },
                                                                "children": []
                                                            },
                                                            {
                                                                "data": {
                                                                    "id": "d8hk6h4rsbc0",
                                                                    "created": 1742114866410,
                                                                    "text": "ストップシーケンス",
                                                                    "note": "ストップシーケンスで設定した単語が出現すると生成を終了する"
                                                                },
                                                                "children": []
                                                            }
                                                        ]
                                                    }
                                                ]
                                            }
                                        ]
                                    },
                                    {
                                        "data": {
                                            "id": "d8azue41p400",
                                            "created": 1741448137528,
                                            "text": "ファインチューニング",
                                            "layout": null,
                                            "expandState": "expand"
                                        },
                                        "children": []
                                    },
                                    {
                                        "data": {
                                            "id": "d8asey1limw0",
                                            "created": 1741427179319,
                                            "text": "RAG\nRetrieval Augmented Generation\n検索拡張生成",
                                            "layout": null,
                                            "expandState": "expand",
                                            "note": "ChatGPTやGeminiに代表されるチャットAIに独自の情報源を付与する仕組みのことで、\n具体的には言語モデルによるテキスト生成に特定の知識や情報源（例えばナレッジベースなど）への検索を組み合わせることである。\n\nこれにより、回答内容がより専門的かつ正確になるため、事実とは異なる内容や文脈と無関係な内容の出力がもっともらしく生成される問題（ハルシネーション）をより回避しやすくなるというメリットがある。\n\nLLMに独自の知識をインプットして特化モデルへ育成するのはファインチューニング。\nRAGはあくまで独自知識の情報源置き場を都度探して、汎用モデルに都度インプットする。\nhttps://www.dir.co.jp/world/entry/solution/rag\n"
                                        },
                                        "children": []
                                    },
                                    {
                                        "data": {
                                            "id": "d8asdmwu0a80",
                                            "created": 1741427076722,
                                            "text": "AWS Bedrock",
                                            "layout": null,
                                            "expandState": "expand"
                                        },
                                        "children": [
                                            {
                                                "data": {
                                                    "id": "d8dhn9ir9340",
                                                    "created": 1741701478876,
                                                    "text": "基盤モデルをAWSからサーバレスで使える"
                                                },
                                                "children": []
                                            },
                                            {
                                                "data": {
                                                    "id": "d8hipudr52w0",
                                                    "created": 1742110741950,
                                                    "text": "クォータ：制限"
                                                },
                                                "children": []
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "data": {
                                    "id": "d8awrbdyb7s0",
                                    "created": 1741439433174,
                                    "text": "コンピュータビジョン（CV）",
                                    "note": "コンピュータが画像や動画を理解し、分析する技術",
