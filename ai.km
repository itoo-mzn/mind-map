                                                                },
                                                                "children": [
                                                                    {
                                                                        "data": {
                                                                            "id": "d8czq3ynf680",
                                                                            "created": 1741650921890,
                                                                            "text": "Tier",
                                                                            "note": "１分間当たりの制限\nでさらにこの上に１日あたりの制限というのがあります。",
